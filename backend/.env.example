# Copy this file to backend/.env. Do not commit backend/.env.

# PostgreSQL used by auth-service and user-service
DB_USER=postgres
USERS_DB_PASSWORD=change-this-password

# Host ports (container-to-container traffic uses Docker service names/ports)
POSTGRES_HOST_PORT=15432
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=16379

# Browser origin allowed by api-gateway
ORIGINS=http://localhost:3000
